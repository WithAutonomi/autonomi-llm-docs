{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "autonomi-md-proxy",
  "main": "src/index.js",
  "compatibility_date": "2025-12-09",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "autonomi.com/*",
      "zone_name": "autonomi.com",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
